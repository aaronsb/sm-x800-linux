# Reference: <https://postmarketos.org/devicepkg>
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=device-samsung-gts8pwifi
pkgdesc="Samsung Galaxy Tab S8+ (Wi-Fi)"
pkgver=0.1
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-samsung-gts8pwifi
	android-tools
	mkbootimg
	postmarketos-base
	msm-fb-refresher
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf initfs-hook.sh stock-fdt.dtb"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Ship the real stock DTB (pulled from /sys/firmware/fdt) so boot-deploy's
	# v4 path can put it in vendor_boot. deviceinfo_dtb="stock-fdt".
	install -Dm644 "$srcdir/stock-fdt.dtb" "$pkgdir/usr/share/dtb/stock-fdt.dtb"
}

