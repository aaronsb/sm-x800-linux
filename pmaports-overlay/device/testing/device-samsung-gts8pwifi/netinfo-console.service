[Unit]
Description=Print network state to the console (gts8pwifi bring-up debug)
# Start early and keep running; we want to see the "no lease" state too.
After=systemd-udevd.service
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/usr/bin/netinfo-console
Restart=always
RestartSec=5
# Write directly to the framebuffer console — there is no other output path.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
