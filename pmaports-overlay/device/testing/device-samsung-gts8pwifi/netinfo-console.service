[Unit]
Description=Generate /etc/issue login banner (gts8pwifi)
# Banner facts are local (os-release, meminfo); no network dependency —
# agetty resolves the IP escapes itself every time it prints the prompt.
Before=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/netinfo-console

[Install]
WantedBy=multi-user.target
