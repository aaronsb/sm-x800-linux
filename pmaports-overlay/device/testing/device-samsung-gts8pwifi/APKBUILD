# Reference: <https://postmarketos.org/devicepkg>
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=device-samsung-gts8pwifi
pkgdesc="Samsung Galaxy Tab S8+ (Wi-Fi) - mainline (SM8450)"
pkgver=0.1
pkgrel=31
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8450
	postmarketos-base
	mkbootimg
	android-tools
	mdev-conf
	reboot-mode
	linux-firmware-qcom
	linux-firmware-ath11k
	linux-firmware-qca
	linux-firmware-rtl_nic
	bluez-btmgmt
	hexagonrpcd
	hexagonrpcd-udev
	libssc
	iio-sensor-proxy
	folio-state
	evtest
	make-dynpart-mappings
	device-mapper
	umtprd
"
subpackages="$pkgname-systemd $pkgname-tools $pkgname-devsudo"
makedepends="devicepkg-dev"
source="deviceinfo mkinitfs-mdev.files mkinitfs-gpu-fw.files netinfo-console.sh netinfo-console.service getty-issue.conf profile-locale.sh panel-blank.sh fw-extract.sh therm.sh setup.sh 90-gts8pwifi-cs35l45-no-hibernate.rules bt-addr.sh bt-addr.service 90-gts8pwifi-bt-addr.rules ucm2/Samsung-Galaxy-Tab-S8-Plus.conf ucm2/HiFi.conf devsudo-sudoers Samsung-Galaxy-Tab-S8-Plus-tplg.bin 81-libssc-samsung-gts8pwifi.rules 90-gts8pwifi-hexagonrpcd-sdsp.rules console-blank.sh console-blank.conf console-blank.service 80-gts8pwifi.preset 50-gts8pwifi-logind.conf usb-gadget.sh usb-gadget.service umtprd.conf"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Add /lib/mdev/persistent-storage to the first-stage initramfs.
	# Without it mdev cannot create /dev/disk/by-uuid symlinks and the
	# initramfs can never find root by UUID. See the file for details.
	install -Dm644 "$srcdir"/mkinitfs-mdev.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-gts8pwifi-mdev.files

	# GPU firmware must ride in the first-stage initramfs: a7xx adreno
	# loads SQE at bind time, before the rootfs exists. See the file.
	install -Dm644 "$srcdir"/mkinitfs-gpu-fw.files \
		"$pkgdir"/usr/share/mkinitfs/files/60-gts8pwifi-gpu-fw.files

	# UTF-8 for login shells — musl's built-in C.UTF-8; btop and friends
	# refuse to draw without it.
	install -Dm644 "$srcdir"/profile-locale.sh \
		"$pkgdir"/etc/profile.d/locale.sh

	# Extractor for device-signed blobs (zap shader, DSP images) and the
	# proprietary sensor registry configs: we ship the TOOL, the user
	# dumps the firmware from their own device. See the script.
	install -Dm755 "$srcdir"/fw-extract.sh \
		"$pkgdir"/usr/bin/gts8pwifi-fw-extract

	# Thermistors: mainline's generic NTC table against stock's per-part
	# microvolt tables from the stock device tree. See the script header.
	install -Dm755 "$srcdir"/therm.sh \
		"$pkgdir"/usr/bin/gts8pwifi-therm

	# One-command daily-driver assembly on a fresh minimal rootfs.
	install -Dm755 "$srcdir"/setup.sh \
		"$pkgdir"/usr/bin/gts8pwifi-setup

	# Login banner generator: writes /etc/issue (art + specs + agetty
	# escapes for live IP). v1 spammed the console; see the script header.
	install -Dm755 "$srcdir"/netinfo-console.sh \
		"$pkgdir"/usr/bin/netinfo-console

	# Manual panel off/on. With the native panel driver this is a real
	# DPMS power cycle; a legacy fbcon/zero-fb fallback remains for
	# simpledrm boots. See the script header.
	install -Dm755 "$srcdir"/panel-blank.sh \
		"$pkgdir"/usr/bin/panel-blank

	# Console display policy: after BLANK_MIN minutes without input fbcon
	# is unbound and the framebuffer zeroed (unlit pixels are off on this
	# panel); the next key or touch repaints. While folio-state reports
	# SW_LID closed the console stays dark; the power button toggles it
	# with the lid open. The unit lives in -systemd; the setting is
	# /etc/conf.d/console-blank. See the script header.
	install -Dm755 "$srcdir"/console-blank.sh \
		"$pkgdir"/usr/bin/console-blank
	install -Dm644 "$srcdir"/console-blank.conf \
		"$pkgdir"/etc/conf.d/console-blank

	# The tablet as a USB device to a PC: NCM ethernet and ACM serial on
	# one configfs gadget. The unit and the usb0 address are in -systemd.
	install -Dm755 "$srcdir"/usb-gadget.sh \
		"$pkgdir"/usr/bin/gts8pwifi-usb-gadget
	# MTP function of the gadget: what the PC's file manager may browse.
	install -Dm644 "$srcdir"/umtprd.conf \
		"$pkgdir"/etc/umtprd/umtprd.conf

	# Sensors: accelerometer mount matrix for iio-sensor-proxy's libssc
	# backend, keyed on the FastRPC node as device-fairphone-fp4 does.
	install -Dm644 "$srcdir"/81-libssc-samsung-gts8pwifi.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-samsung-gts8pwifi.rules

	# Audio: keep the CS35L45 amps out of runtime suspend (see the rule).
	install -Dm644 "$srcdir"/90-gts8pwifi-cs35l45-no-hibernate.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-gts8pwifi-cs35l45-no-hibernate.rules

	# Bluetooth: the controller comes up unconfigured (no local-bd-address
	# from DT or bootloader). This reads the factory address from the efs
	# partition and hands it to hci0 with btmgmt; the udev rule and unit
	# that trigger it live in the systemd subpackage. See the script header.
	install -Dm755 "$srcdir"/bt-addr.sh \
		"$pkgdir"/usr/bin/gts8pwifi-bt-addr

	# Audio: UCM profile for the "Samsung-Galaxy-Tab-S8-Plus" card. The
	# card driver name is "sm8450", so alsa-ucm-conf looks in
	# conf.d/sm8450/<card long name>.conf.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Plus.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Samsung-Galaxy-Tab-S8-Plus.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/gts8pwifi/HiFi.conf

	# Audio: AudioReach topology, loaded by q6apm as
	# qcom/sm8450/<card model>-tplg.bin. Derived from linux-firmware's
	# SM8450-HDK topology (BSD-3-Clause, linux-msm/audioreach-topology)
	# with the PRIMARY_MI2S_RX data line moved from SD0 to SD1 -- see
	# tools/mk-tplg.py for the derivation and why.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Plus-tplg.bin \
		"$pkgdir"/usr/lib/firmware/qcom/sm8450/Samsung-Galaxy-Tab-S8-Plus-tplg.bin
}

devsudo() {
	pkgdesc="Passwordless sudo for the default user (development only)"
	install_if=""
	install -Dm440 "$srcdir"/devsudo-sudoers \
		"$subpkgdir"/etc/sudoers.d/10-gts8pwifi-devsudo
}

tools() {
	pkgdesc="Curated on-device toolkit for the gts8pwifi port (metapackage)"
	# Alpine's package-selection unit: no files, only depends. Everything
	# tools/README used to say to re-install by hand after a userdata flash.
	depends="
		i2c-tools
		libgpiod
		evtest
		iw
		wpa_supplicant
		tcpdump
		bluez
		mesa-dri-gallium
		kmscube
		btop
		strace
	"
	mkdir -p "$subpkgdir"
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends="hexagonrpcd-systemd iio-sensor-proxy-systemd folio-state-systemd
		unudhcpd-systemd umtprd-systemd"
	install -Dm644 "$srcdir"/netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/netinfo-console.service
	install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -sf ../netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/netinfo-console.service

	# Console blanking and lid policy (AMOLED): the watcher behind
	# /etc/conf.d/console-blank. Reads SW_LID from folio-state.
	install -Dm644 "$srcdir"/console-blank.service \
		"$subpkgdir"/usr/lib/systemd/system/console-blank.service
	ln -sf ../console-blank.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/console-blank.service

	# Vendor wants symlinks read "disabled" from is-enabled; the preset
	# makes the state read what it is (issue #41).
	install -Dm644 "$srcdir"/80-gts8pwifi.preset \
		"$subpkgdir"/usr/lib/systemd/system-preset/80-gts8pwifi.preset

	# The lid switch belongs to console-blank, not logind (ADR-002).
	install -Dm644 "$srcdir"/50-gts8pwifi-logind.conf \
		"$subpkgdir"/usr/lib/systemd/logind.conf.d/50-gts8pwifi.conf

	# agetty needs --issue-file spelled out on Alpine or the banner never
	# prints — see the drop-in's comment.
	install -Dm644 "$srcdir"/getty-issue.conf \
		"$subpkgdir"/usr/lib/systemd/system/getty@tty1.service.d/10-gts8pwifi-issue.conf

	# Bluetooth public address: udev pulls the oneshot in when hci0 appears
	# (ENV{SYSTEMD_WANTS}), so the unit has no [Install] section.
	install -Dm644 "$srcdir"/bt-addr.service \
		"$subpkgdir"/usr/lib/systemd/system/gts8pwifi-bt-addr.service
	install -Dm644 "$srcdir"/90-gts8pwifi-bt-addr.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-gts8pwifi-bt-addr.rules

	# USB gadget: built when the UDC appears (usb-gadget.target), with
	# unudhcpd@usb0 and a serial getty on ttyGS0 pulled in by the unit.
	install -Dm644 "$srcdir"/usb-gadget.service \
		"$subpkgdir"/usr/lib/systemd/system/gts8pwifi-usb-gadget.service
	install -d "$subpkgdir"/usr/lib/systemd/system/usb-gadget.target.wants
	ln -sf ../gts8pwifi-usb-gadget.service \
		"$subpkgdir"/usr/lib/systemd/system/usb-gadget.target.wants/gts8pwifi-usb-gadget.service

	# Sensor hub: start hexagonrpcd-sdsp when /dev/fastrpc-sdsp appears
	# (the unit's path condition is evaluated before the SLPI boots).
	install -Dm644 "$srcdir"/90-gts8pwifi-hexagonrpcd-sdsp.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-gts8pwifi-hexagonrpcd-sdsp.rules
}

