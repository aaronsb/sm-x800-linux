# Reference: <https://postmarketos.org/devicepkg>
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=device-samsung-gts8pwifi
pkgdesc="Samsung Galaxy Tab S8+ (Wi-Fi) - mainline (SM8450)"
pkgver=0.1
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8450
	postmarketos-base
	mkbootimg
	android-tools
	mdev-conf
"
subpackages="$pkgname-systemd"
makedepends="devicepkg-dev"
source="deviceinfo mkinitfs-mdev.files netinfo-console.sh netinfo-console.service"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Add /lib/mdev/persistent-storage to the first-stage initramfs.
	# Without it mdev cannot create /dev/disk/by-uuid symlinks and the
	# initramfs can never find root by UUID. See the file for details.
	install -Dm644 "$srcdir"/mkinitfs-mdev.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-gts8pwifi-mdev.files

	# Bring-up debug: with no working input, the panel is the only way to
	# learn what IP we got. Print iface/mac/ip/gateway to the console on
	# every change. Drop this once ssh or serial access is reliable.
	install -Dm755 "$srcdir"/netinfo-console.sh \
		"$pkgdir"/usr/bin/netinfo-console
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/netinfo-console.service
	install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -sf ../netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/netinfo-console.service
}

sha512sums="
9d7b12654e6d46a6a374a56484ae61146b655138b60b8a3f5b702db72907a45c3cefd2748fc3e7cd035d293684c8155abb5ce724a5e9738ab97536fb311a5344  deviceinfo
"
