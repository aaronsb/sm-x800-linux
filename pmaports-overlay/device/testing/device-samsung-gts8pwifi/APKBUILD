# Reference: <https://postmarketos.org/devicepkg>
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=device-samsung-gts8pwifi
pkgdesc="Samsung Galaxy Tab S8+ (Wi-Fi) - mainline (SM8450)"
pkgver=0.1
pkgrel=14
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8450
	postmarketos-base
	mkbootimg
	android-tools
	mdev-conf
	reboot-mode
	linux-firmware-qcom
"
subpackages="$pkgname-systemd"
makedepends="devicepkg-dev"
source="deviceinfo mkinitfs-mdev.files mkinitfs-gpu-fw.files netinfo-console.sh netinfo-console.service panel-blank.sh vbus-otg.sh usb-host-wake.start fw-extract.sh"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Add /lib/mdev/persistent-storage to the first-stage initramfs.
	# Without it mdev cannot create /dev/disk/by-uuid symlinks and the
	# initramfs can never find root by UUID. See the file for details.
	install -Dm644 "$srcdir"/mkinitfs-mdev.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-gts8pwifi-mdev.files

	# GPU firmware must ride in the first-stage initramfs: a7xx adreno
	# loads SQE at bind time, before the rootfs exists. See the file.
	install -Dm644 "$srcdir"/mkinitfs-gpu-fw.files \
		"$pkgdir"/usr/share/mkinitfs/files/60-gts8pwifi-gpu-fw.files

	# Extractor for device-signed blobs (zap shader): we ship the TOOL,
	# the user dumps the firmware from their own device. See the script.
	install -Dm755 "$srcdir"/fw-extract.sh \
		"$pkgdir"/usr/bin/gts8pwifi-fw-extract

	# Bring-up debug: with no working input, the panel is the only way to
	# learn what IP we got. Print iface/mac/ip/gateway to the console on
	# every change. Drop this once ssh or serial access is reliable.
	install -Dm755 "$srcdir"/netinfo-console.sh \
		"$pkgdir"/usr/bin/netinfo-console

	# Manual OLED burn-in protection. There is no backlight or DSI driver
	# here (DRM_MSM=n, simpledrm owns the panel), so "screen off" means
	# zeroing the framebuffer. See the script header.
	install -Dm755 "$srcdir"/panel-blank.sh \
		"$pkgdir"/usr/bin/panel-blank

	# Manual USB VBUS sourcing (MAX77705 OTG boost) — powers bus-powered
	# USB peripherals in host mode. See the script header.
	install -Dm755 "$srcdir"/vbus-otg.sh \
		"$pkgdir"/usr/bin/vbus-otg

	# Root hubs must not runtime-suspend or hot-plugged devices on
	# tablet-sourced VBUS are never detected. See the script header.
	install -Dm755 "$srcdir"/usb-host-wake.start \
		"$pkgdir"/etc/local.d/usb-host-wake.start
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/netinfo-console.service
	install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -sf ../netinfo-console.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/netinfo-console.service
}

