+static const char * const hi847_supply_names[] = {
+	"vddio", /* Digital I/O */
+	"vdda", /* Analog */
+	"vddd", /* Digital core */
+};
+
+#define HI847_NUM_SUPPLIES ARRAY_SIZE(hi847_supply_names)
+
 struct hi847 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *shutdown_gpio;
+	struct regulator_bulk_data supplies[HI847_NUM_SUPPLIES];
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -2765,6 +2778,101 @@ static const struct v4l2_subdev_internal_ops hi847_internal_ops = {
 	.open = hi847_open,
 };
 
+/*
+ * Power-up order and delays follow the module vendor's sequence:
+ * supplies, 5 ms, MCLK, 8 ms, reset release, 11 ms. On ACPI platforms the
+ * supplies are dummy regulators, the clock is a fixed-rate stub and the
+ * GPIOs are absent, so only the delays remain.
+ */
+static int hi847_power_on(struct hi847 *hi847)
+{
+	int ret;
+
+	ret = regulator_bulk_enable(HI847_NUM_SUPPLIES, hi847->supplies);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(5000, 6000);
+
+	ret = clk_prepare_enable(hi847->clk);
+	if (ret < 0)
+		goto err_reg;
+
+	usleep_range(8000, 9000);
+
+	if (hi847->shutdown_gpio || hi847->reset_gpio) {
+		gpiod_set_value_cansleep(hi847->shutdown_gpio, 0);
+		gpiod_set_value_cansleep(hi847->reset_gpio, 0);
+		usleep_range(11000, 12000);
+	}
+
+	return 0;
+
+err_reg:
+	regulator_bulk_disable(HI847_NUM_SUPPLIES, hi847->supplies);
+
+	return ret;
+}
+
+static int hi847_power_off(struct hi847 *hi847)
+{
+	if (hi847->shutdown_gpio || hi847->reset_gpio) {
+		gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+		gpiod_set_value_cansleep(hi847->shutdown_gpio, 1);
+		usleep_range(1000, 2000);
+	}
+
+	clk_disable_unprepare(hi847->clk);
+	usleep_range(1000, 2000);
+
+	return regulator_bulk_disable(HI847_NUM_SUPPLIES, hi847->supplies);
+}
+
+static int hi847_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+
+	return hi847_power_off(hi847);
+}
+
+static int hi847_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+
+	return hi847_power_on(hi847);
+}
+
+static int hi847_get_power_resources(struct hi847 *hi847)
+{
+	struct device *dev = hi847->dev;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < HI847_NUM_SUPPLIES; i++)
+		hi847->supplies[i].supply = hi847_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, HI847_NUM_SUPPLIES, hi847->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* Both pins are active-low; logical 1 holds the sensor down. */
+	hi847->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(hi847->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(hi847->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	hi847->shutdown_gpio = devm_gpiod_get_optional(dev, "shutdown",
+						       GPIOD_OUT_HIGH);
+	if (IS_ERR(hi847->shutdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(hi847->shutdown_gpio),
+				     "failed to get shutdown gpio\n");
+
+	return 0;
+}
+
 static int hi847_identify_module(struct hi847 *hi847)
 {
 	int ret;
@@ -2848,7 +2956,12 @@ static void hi847_remove(struct i2c_client *client)
 	v4l2_async_unregister_subdev(sd);
