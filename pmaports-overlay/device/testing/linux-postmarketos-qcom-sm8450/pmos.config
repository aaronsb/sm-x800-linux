# pmOS + first-boot-visibility overrides, merged on top of the arm64
# defconfig + the sm8450.config fragment staged next to this file.
#
# GOAL: a VISIBLE first boot. The Samsung bootloader leaves the panel
# scanning the cont_splash framebuffer at 0xb8000000; simple-framebuffer +
# fbcon paints the kernel log and the login prompt straight onto the panel.
#
# DRM_MSM is DISABLED for the first boot on purpose: our S6TUUM1 DDIC has no
# mainline panel driver, so if DRM_MSM bound the display pipeline it would
# evict simpledrm (aperture handoff) and leave a black screen. With it off,
# simpledrm owns the console for the entire boot. Flip to =m once boot is
# confirmed, to start bringing up the real display stack.
CONFIG_DRM_MSM=n

# simple-framebuffer console path
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y

# earlycon / serial console (earlycon=qcom_geni,0x0099c000 console=ttyMSM0)
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# USB gadget networking, so we can also get a shell over USB-C once
# userspace is up (belt and suspenders alongside the panel console).
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# Keep the boot log verbose and on-screen.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Big console font. At 2800x1752 the default 8x16 font gives ~350 columns —
# a scrolling kernel log is literally unreadable and photographs as noise,
# which made it impossible to tell a real boot log from framebuffer garbage.
# TER16x32 gives ~175 columns and is legible in a phone photo of the panel.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y

# Input: the PMIC power key / resin (volume down) are the only working input
# devices during bring-up, and pmOS's initramfs uses volume-down to drop to a
# debug shell. Without these the nodes probe nothing.
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y

# Touchscreen: STMicro FingerTip FTS1BA90A at i2c8 0x49, driven by our
# fts1ba90a.c port (staged into drivers/input/touchscreen/ by the APKBUILD,
# built via obj-y so it needs no CONFIG_ symbol of its own — only this switch
# that pulls the directory into the build). stmfts was tried first and CANNOT
# work: FTS1BA90A uses 16-byte events and opcodes 0x60/0x61, stmfts expects
# 8-byte events and 0x85/0x86 — it probed with error -110.
CONFIG_INPUT_TOUCHSCREEN=y
# the driver reports via multitouch slots; without evdev there is no usable input.
CONFIG_INPUT_EVDEV=y

# USB gadget serial: pmOS's debug shell exposes a console on /dev/ttyGS0.
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y

# i2cdetect / i2cget from userspace (pogo STM32 probe on i2c18).
CONFIG_I2C_CHARDEV=y

# MAX77705 top and charger (ADR-003 stage 2): upstream drivers, with the
# PASS2 revision accepted and an OTG regulator added to the charger.
CONFIG_MFD_MAX77705=y
CONFIG_CHARGER_MAX77705=y

# MAX77705 CCIC (ADR-003 stage 3): Type-C port, dwc3 role switch, VBUS by
# attach through the charger's OTG regulator, fixed-PDO PD sink at <= 9 V
# and 15 W. Replaces the userspace vbus-otg switch (regulator-output node
# and REGULATOR_USERSPACE_CONSUMER, both dropped in r33).
CONFIG_TYPEC_MAX77705=y

# Battery visibility: the MAX77705 fuel gauge at 0x36 on i2c5 is a
# MAX17047-class gauge; mainline binds it as "maxim,max77705-battery". It
# only reads here (Status POR clear, so no model load) and gives
# /sys/class/power_supply/ capacity, voltage, current and temperature.
CONFIG_BATTERY_MAX17042=y

# Native display: MSM DRM (DPU+DSI) with our S6TUUM1 panel driver (staged by
# the APKBUILD). simpledrm hands off via the aperture helper at msm probe.
CONFIG_DRM_MSM=y
CONFIG_I2C_GPIO=y

# Audio. The four Cirrus CS35L45 speaker amplifiers sit on i2c4 and take
# Primary MI2S from the ADSP (AudioReach). Built in rather than modular so
# the ADSP boots and the card probes with no module-ordering games: the
# in-kernel pd-mapper must answer the servreg locator before q6apm/q6prm
# come up, and both ride on QRTR over GLINK to the ADSP.
#
# The vanilla arm64 defconfig builds the whole sound stack as modules
# (CONFIG_SND=m, CONFIG_SND_SOC=m, the QDSP6 and machine drivers =m), and
# =m in the base wins over a select from a =y child, so every layer the
# card needs is pinned to =y here. The sm8450-mainline tree this port ran
# until 2026-09 had them built in through its own defconfig edits.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_CS35L45=y
CONFIG_SND_SOC_CS35L45_I2C=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
