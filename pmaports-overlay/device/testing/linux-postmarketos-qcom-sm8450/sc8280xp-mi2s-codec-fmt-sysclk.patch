sc8280xp-mi2s-codec-fmt-sysclk

Configure the codec side of MI2S backends: DAI format and bit clock.

The mainline sc8280xp machine driver (with the MI2S DAI-format backport)
tells the CPU DAI that the LPASS provides bit clock and frame sync, but
never tells the codec DAI anything. An I2S codec such as the CS35L45
keeps its reset-default format and is never told the bit clock rate its
PLL must lock to, so it plays silence. Set I2S/NB_NF/consumer on every
codec DAI of an MI2S link and hand it the 48 kHz x 16 bit x 2 channel
bit clock the BE hw_params fixup pins.

Taken from the Galaxy Tab S9 Ultra port (agcarbajo/postmarketos-galaxy-
tab-s9-ultra, set-mi2s-codec-dai-format.patch), rebased onto v7.2 where
sc8280xp_be_ops routes hw_params through prepare and the CPU-side MI2S
format is set in sc8280xp_snd_init(). Obsoleted upstream once the machine
driver configures codec DAIs on MI2S links itself (not yet, as of 7.2).

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 98b15a527..f6e4afabd 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -114,8 +114,59 @@ static int sc8280xp_snd_hw_free(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_hw_free(substream, &data->stream_prepared[cpu_dai->id]);
 }
 
+/* 48 kHz, 16 bit, 2 channels: the rate the BE hw_params fixup pins. */
+#define MI2S_BCLK_RATE		1536000
+
+static bool sc8280xp_is_mi2s(int dai_id)
+{
+	switch (dai_id) {
+	case PRIMARY_MI2S_RX ... QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX ... QUINARY_MI2S_TX:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * sc8280xp_snd_init() tells the CPU side that the LPASS provides bit clock
+ * and frame sync on MI2S, but the codec side was never told anything: an I2S
+ * codec kept its reset default format and was never given the bit clock rate
+ * it has to lock its PLL to, so it produced no audio at all. AudioReach
+ * programs the I2S port itself, so the CPU DAI needs no sysclk here; the
+ * codec does.
+ */
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	int i, ret;
+
+	if (sc8280xp_is_mi2s(cpu_dai->id)) {
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			ret = snd_soc_dai_set_fmt(codec_dai,
+						  SND_SOC_DAIFMT_CBC_CFC |
+						  SND_SOC_DAIFMT_I2S |
+						  SND_SOC_DAIFMT_NB_NF);
+			if (ret && ret != -ENOTSUPP)
+				return dev_err_probe(rtd->dev, ret,
+						     "failed to set codec fmt\n");
+
+			ret = snd_soc_dai_set_sysclk(codec_dai, 0,
+						     MI2S_BCLK_RATE,
+						     SND_SOC_CLOCK_IN);
+			if (ret && ret != -ENOTSUPP)
+				return dev_err_probe(rtd->dev, ret,
+						     "failed to set codec sysclk\n");
+		}
+	}
+
+	return qcom_snd_sdw_startup(substream);
+}
+
 static const struct snd_soc_ops sc8280xp_be_ops = {
-	.startup = qcom_snd_sdw_startup,
+	.startup = sc8280xp_snd_startup,
 	.shutdown = qcom_snd_sdw_shutdown,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
