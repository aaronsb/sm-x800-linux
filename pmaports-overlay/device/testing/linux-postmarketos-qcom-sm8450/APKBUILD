# Reference: <https://postmarketos.org/vendorkernel>
# Kernel: sm8450-mainline/linux (next-new), built like the archived
# linux-postmarketos-qcom-sm8350 package. Config is generated from the
# tree's own defconfig + sm8450.config fragment, then a small pmOS +
# first-boot-visibility fragment (pmos.config) is merged on top.
maintainer="Aaron <aaronsb@gmail.com>"
_flavor="postmarketos-qcom-sm8450"
pkgname=linux-$_flavor
pkgver=6.13_rc3
pkgrel=14
pkgdesc="Mainline kernel fork for Qualcomm SM8450 (Waipio) devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bison
	devicepkg-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	perl
"

_commit="bf1d29fced6e156dd6090a9b6600a8c44259c114"
_config="pmos.config"

# Source
source="
	$pkgname-$_commit.tar.gz::https://github.com/sm8450-mainline/linux/archive/$_commit.tar.gz
	pmos.config
	sm8450-samsung-gts8pwifi.dts
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare

	# Add our device DTS to the SM8450 device-tree build list.
	cp "$srcdir"/sm8450-samsung-gts8pwifi.dts \
		arch/arm64/boot/dts/qcom/sm8450-samsung-gts8pwifi.dts
	if ! grep -q "sm8450-samsung-gts8pwifi.dtb" \
			arch/arm64/boot/dts/qcom/Makefile; then
		echo 'dtb-$(CONFIG_ARCH_QCOM) += sm8450-samsung-gts8pwifi.dtb' \
			>> arch/arm64/boot/dts/qcom/Makefile
	fi

	# Generate .config: tree defconfig + sm8450 fragment, then merge the
	# pmOS/visibility overrides and let olddefconfig resolve the rest.
	make ARCH="$_carch" defconfig sm8450.config
	KCONFIG_CONFIG=.config ./scripts/kconfig/merge_config.sh -m \
		.config "$srcdir"/pmos.config
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image.gz modules dtbs
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

