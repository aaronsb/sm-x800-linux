# Reference: <https://postmarketos.org/vendorkernel>
# Kernel: vanilla mainline (torvalds v7.2 release tarball), built like the
# archived linux-postmarketos-qcom-sm8350 package. Config is generated from
# the tree's arm64 defconfig + the sm8450.config fragment we carry (taken
# from sm8450-mainline/linux, which mainline never gained), then a small
# pmOS + first-boot-visibility fragment (pmos.config) is merged on top.
maintainer="Aaron <aaronsb@gmail.com>"
_flavor="postmarketos-qcom-sm8450"
pkgname=linux-$_flavor
pkgver=7.2
pkgrel=0
pkgdesc="Mainline kernel for Qualcomm SM8450 (Waipio) devices"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bison
	devicepkg-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	perl
	python3
"

_config="pmos.config"

# Source
source="
	https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	sm8450.config
	pmos.config
	sm8450-samsung-gts8pwifi.dts
	fts1ba90a.c
	stm32-pogo.c
	wacom-wez01.c
	max77705-otg.c
	panel-samsung-s6tuum1.c
	sc8280xp-mi2s-codec-fmt-sysclk.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare

	# Add our device DTS to the SM8450 device-tree build list.
	cp "$srcdir"/sm8450-samsung-gts8pwifi.dts \
		arch/arm64/boot/dts/qcom/sm8450-samsung-gts8pwifi.dts
	if ! grep -q "sm8450-samsung-gts8pwifi.dtb" \
			arch/arm64/boot/dts/qcom/Makefile; then
		echo 'dtb-$(CONFIG_ARCH_QCOM) += sm8450-samsung-gts8pwifi.dtb' \
			>> arch/arm64/boot/dts/qcom/Makefile
	fi

	# Touchscreen: our fts1ba90a port (see the file's header comment for
	# why mainline stmfts cannot drive this part). Built unconditionally
	# via obj-y so no Kconfig surgery is needed; the touchscreen dir is
	# already in the build through CONFIG_INPUT_TOUCHSCREEN=y.
	cp "$srcdir"/fts1ba90a.c drivers/input/touchscreen/fts1ba90a.c
	if ! grep -q "fts1ba90a.o" drivers/input/touchscreen/Makefile; then
		echo 'obj-y += fts1ba90a.o' >> drivers/input/touchscreen/Makefile
	fi

	# Pogo Book Cover Keyboard: same obj-y staging pattern. The keyboard
	# dir is in the build through CONFIG_INPUT_KEYBOARD=y (gpio-keys).
	cp "$srcdir"/stm32-pogo.c drivers/input/keyboard/stm32-pogo.c
	if ! grep -q "stm32-pogo.o" drivers/input/keyboard/Makefile; then
		echo 'obj-y += stm32-pogo.o' >> drivers/input/keyboard/Makefile
	fi

	# S Pen: our wacom-wez01 port (see the file's header + device-facts/
	# wacom-wez01.md). Same obj-y staging into the touchscreen dir, which is
	# already built via CONFIG_INPUT_TOUCHSCREEN=y.
	cp "$srcdir"/wacom-wez01.c drivers/input/touchscreen/wacom-wez01.c
	if ! grep -q "wacom-wez01.o" drivers/input/touchscreen/Makefile; then
		echo 'obj-y += wacom-wez01.o' >> drivers/input/touchscreen/Makefile
	fi

	# MAX77705 OTG VBUS boost (USB host-mode power), same pattern.
	cp "$srcdir"/max77705-otg.c drivers/regulator/max77705-otg.c
	if ! grep -q "max77705-otg.o" drivers/regulator/Makefile; then
		echo 'obj-y += max77705-otg.o' >> drivers/regulator/Makefile
	fi

	# S6TUUM1 panel driver (native display), same pattern. The panel dir
	# is always built (obj-y += panel/ in drivers/gpu/drm/Makefile).
	cp "$srcdir"/panel-samsung-s6tuum1.c \
		drivers/gpu/drm/panel/panel-samsung-s6tuum1.c
	if ! grep -q "panel-samsung-s6tuum1.o" drivers/gpu/drm/panel/Makefile; then
		echo 'obj-y += panel-samsung-s6tuum1.o' >> drivers/gpu/drm/panel/Makefile
	fi

	# Generate .config: arm64 defconfig + the SM8450 fragment (staged, since
	# mainline carries no arch/arm64/configs/sm8450.config), then merge the
	# pmOS/visibility overrides and let olddefconfig resolve the rest.
	cp "$srcdir"/sm8450.config arch/arm64/configs/sm8450.config
	make ARCH="$_carch" defconfig sm8450.config
	KCONFIG_CONFIG=.config ./scripts/kconfig/merge_config.sh -m \
		.config "$srcdir"/pmos.config
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image.gz modules dtbs
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums=""
