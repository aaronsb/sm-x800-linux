diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 4148009e0..4221c61d0 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -7,6 +7,8 @@
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 
@@ -24,8 +26,14 @@
  */
 #define DW9807_CTRL_STEPS	16
 #define DW9807_CTRL_DELAY_US	1000
+/* Settling time after the supply is switched on, before the first write. */
+#define DW9807_POWER_ON_DELAY_US	10000
+/* Settling time after the DW9808 leaves power-down during its bring-up. */
+#define DW9808_RESET_DELAY_US	5000
 
 #define DW9807_CTL_ADDR		0x02
+#define DW9807_CTL_PD		BIT(0)
+#define DW9807_CTL_RING		BIT(1)
 /*
  * DW9807 separates two registers to control the VCM position.
  * One for MSB value, another is LSB value.
@@ -36,11 +44,37 @@
 #define DW9807_MODE_ADDR	0x06
 #define DW9807_RESONANCE_ADDR	0x07
 
+/*
+ * DW9808 SAC mode and ring timing, the values the vendor camera stack
+ * programs before it enables ringing control on this part.
+ */
+#define DW9808_MODE_VAL		0x60
+#define DW9808_RESONANCE_VAL	0x05
+
 #define MAX_RETRY		10
 
+/**
+ * struct dw9807_chip_info - per-variant behaviour
+ * @sac_init: program the SAC mode and ring timing registers on power-up
+ *            and enable ringing control once the lens is in position
+ */
+struct dw9807_chip_info {
+	bool sac_init;
+};
+
+static const struct dw9807_chip_info dw9807_chip_info = {
+	.sac_init = false,
+};
+
+static const struct dw9807_chip_info dw9808_chip_info = {
+	.sac_init = true,
+};
+
 struct dw9807_device {
 	struct v4l2_ctrl_handler ctrls_vcm;
 	struct v4l2_subdev sd;
+	struct regulator *vcc;
+	const struct dw9807_chip_info *info;
 	u16 current_val;
 };
 
@@ -73,6 +107,21 @@ static int dw9807_i2c_check(struct i2c_client *client)
 	return status_result;
 }
 
+static int dw9807_write_reg(struct i2c_client *client, u8 reg, u8 val)
+{
+	const char tx_data[2] = { reg, val };
+	int ret;
+
+	ret = i2c_master_send(client, tx_data, sizeof(tx_data));
+	if (ret < 0) {
+		dev_err(&client->dev, "I2C write reg 0x%02x fail ret = %d\n",
+			reg, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
 static int dw9807_set_dac(struct i2c_client *client, u16 data)
 {
 	const char tx_data[3] = {
@@ -185,6 +234,25 @@ static int dw9807_probe(struct i2c_client *client)
 	if (dw9807_dev == NULL)
 		return -ENOMEM;
 
+	dw9807_dev->info = device_get_match_data(&client->dev);
+	if (!dw9807_dev->info)
+		dw9807_dev->info = &dw9807_chip_info;
+
+	/*
+	 * Optional supply. On camera modules the lens driver shares the
+	 * module rail with the sensor; when it is described here the driver
+	 * powers the chip itself around runtime PM, so the lens can be moved
+	 * with the sensor idle.
+	 */
+	dw9807_dev->vcc = devm_regulator_get_optional(&client->dev, "vcc");
+	if (IS_ERR(dw9807_dev->vcc)) {
+		if (PTR_ERR(dw9807_dev->vcc) != -ENODEV)
+			return dev_err_probe(&client->dev,
+					     PTR_ERR(dw9807_dev->vcc),
+					     "failed to get vcc supply\n");
+		dw9807_dev->vcc = NULL;
+	}
+
 	v4l2_i2c_subdev_init(&dw9807_dev->sd, client, &dw9807_ops);
 	dw9807_dev->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	dw9807_dev->sd.internal_ops = &dw9807_int_ops;
@@ -203,9 +271,15 @@ static int dw9807_probe(struct i2c_client *client)
 	if (rval < 0)
 		goto err_cleanup;
 
-	pm_runtime_set_active(&client->dev);
-	pm_runtime_enable(&client->dev);
-	pm_runtime_idle(&client->dev);
+	if (dw9807_dev->vcc) {
+		/* The supply is off; the first open powers the chip up. */
+		pm_runtime_set_suspended(&client->dev);
+		pm_runtime_enable(&client->dev);
+	} else {
+		pm_runtime_set_active(&client->dev);
+		pm_runtime_enable(&client->dev);
+		pm_runtime_idle(&client->dev);
+	}
 
 	return 0;
 
@@ -236,7 +310,6 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 	struct i2c_client *client = to_i2c_client(dev);
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
 	struct dw9807_device *dw9807_dev = sd_to_dw9807_vcm(sd);
-	const char tx_data[2] = { DW9807_CTL_ADDR, 0x01 };
 	int ret, val;
 
 	for (val = dw9807_dev->current_val & ~(DW9807_CTRL_STEPS - 1);
@@ -248,13 +321,12 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 	}
 
 	/* Power down */
-	ret = i2c_master_send(client, tx_data, sizeof(tx_data));
-	if (ret < 0) {
-		dev_err(&client->dev, "I2C write CTL fail ret = %d\n", ret);
-		return ret;
-	}
+	ret = dw9807_write_reg(client, DW9807_CTL_ADDR, DW9807_CTL_PD);
 
-	return 0;
+	if (dw9807_dev->vcc)
+		regulator_disable(dw9807_dev->vcc);
+
+	return ret;
 }
 
 /*
@@ -268,14 +340,43 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 	struct i2c_client *client = to_i2c_client(dev);
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
 	struct dw9807_device *dw9807_dev = sd_to_dw9807_vcm(sd);
-	const char tx_data[2] = { DW9807_CTL_ADDR, 0x00 };
 	int ret, val;
 
-	/* Power on */
-	ret = i2c_master_send(client, tx_data, sizeof(tx_data));
-	if (ret < 0) {
-		dev_err(&client->dev, "I2C write CTL fail ret = %d\n", ret);
-		return ret;
+	if (dw9807_dev->vcc) {
+		ret = regulator_enable(dw9807_dev->vcc);
+		if (ret) {
+			dev_err(dev, "failed to enable vcc: %d\n", ret);
+			return ret;
+		}
+		usleep_range(DW9807_POWER_ON_DELAY_US,
+			     DW9807_POWER_ON_DELAY_US + 1000);
+	}
+
+	if (dw9807_dev->info->sac_init) {
+		/*
+		 * DW9808 bring-up as the vendor stack does it: through
+		 * power-down and back, settle, then SAC mode and ring timing.
+		 */
+		ret = dw9807_write_reg(client, DW9807_CTL_ADDR, DW9807_CTL_PD);
+		if (ret)
+			goto err_power_off;
+		ret = dw9807_write_reg(client, DW9807_CTL_ADDR, 0x00);
+		if (ret)
+			goto err_power_off;
+		usleep_range(DW9808_RESET_DELAY_US, DW9808_RESET_DELAY_US + 500);
+		ret = dw9807_write_reg(client, DW9807_MODE_ADDR,
+				       DW9808_MODE_VAL);
+		if (ret)
+			goto err_power_off;
+		ret = dw9807_write_reg(client, DW9807_RESONANCE_ADDR,
+				       DW9808_RESONANCE_VAL);
+		if (ret)
+			goto err_power_off;
+	} else {
+		/* Power on */
+		ret = dw9807_write_reg(client, DW9807_CTL_ADDR, 0x00);
+		if (ret)
+			goto err_power_off;
 	}
 
 	for (val = dw9807_dev->current_val % DW9807_CTRL_STEPS;
@@ -288,19 +389,35 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 		usleep_range(DW9807_CTRL_DELAY_US, DW9807_CTRL_DELAY_US + 10);
 	}
 
+	if (dw9807_dev->info->sac_init) {
+		/* Ringing control on, now that the lens is in position. */
+		ret = dw9807_write_reg(client, DW9807_CTL_ADDR,
+				       DW9807_CTL_RING);
+		if (ret)
+			goto err_power_off;
+	}
+
 	return 0;
+
+err_power_off:
+	if (dw9807_dev->vcc)
+		regulator_disable(dw9807_dev->vcc);
+
+	return ret;
 }
 
