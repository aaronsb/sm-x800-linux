+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hynix Hi1337 13 MP MIPI CSI-2 image sensor driver.
+ *
+ * The Hi1337 is a 1.0 um, 4208x3120 raw Bayer sensor with a 4-lane D-PHY
+ * output and a 16-bit register map in the Hi847 family style. The register
+ * tables come from the Samsung SM-X800 (Galaxy Tab S8+) stock camera
+ * configuration, where the sensor serves as the rear main and front cameras.
+ * The driver structure follows hi847.c. The sensor-specific skeleton
+ * (identification registers, 8-bit analogue gain, power sequence) draws on
+ * the out-of-tree Galaxy Tab S9 driver by Antonio García Carbajo.
+ *
+ * Copyright (c) 2026 Aaron Bockelie
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#include "hi1337_tables.h"
+
+#define HI1337_REG_VALUE_08BIT		1
+#define HI1337_REG_VALUE_16BIT		2
+
+#define HI1337_LINK_FREQ_704MHZ		704000000ULL
+#define HI1337_MCLK			19200000
+#define HI1337_DATA_LANES		4
+#define HI1337_RGB_DEPTH		10
+
+#define HI1337_REG_VENDOR_ID		0x0714
+#define HI1337_VENDOR_ID		0x2000
+#define HI1337_REG_MODEL_ID		0x0716
+
+#define HI1337_REG_MODE_SELECT		0x0b00
+#define HI1337_MODE_STANDBY		0x0000
+#define HI1337_MODE_STREAMING		0x0100
+
+/* Vertical timing */
+#define HI1337_REG_FLL			0x020e
+#define HI1337_FLL_MAX			0x7fff
+
+/* Horizontal timing */
+#define HI1337_REG_LLP			0x0206
+
+/* Exposure control */
+#define HI1337_REG_EXPOSURE		0x020a
+#define HI1337_EXPOSURE_MIN		4
+#define HI1337_EXPOSURE_MAX_MARGIN	4
+#define HI1337_EXPOSURE_STEP		1
+
+/* Analogue gain control, low byte of the 0x0212 word */
+#define HI1337_REG_ANALOG_GAIN		0x0213
+#define HI1337_ANAL_GAIN_MIN		0
+#define HI1337_ANAL_GAIN_MAX		240
+#define HI1337_ANAL_GAIN_STEP		1
+
+/* Digital gain control, 8.8 fixed point per Bayer channel */
+#define HI1337_REG_MWB_GR_GAIN		0x0214
+#define HI1337_REG_MWB_GB_GAIN		0x0216
+#define HI1337_REG_MWB_R_GAIN		0x0218
+#define HI1337_REG_MWB_B_GAIN		0x021a
+#define HI1337_DGTL_GAIN_MIN		256
+#define HI1337_DGTL_GAIN_MAX		1024
+#define HI1337_DGTL_GAIN_STEP		1
+#define HI1337_DGTL_GAIN_DEFAULT	512
+
+enum {
+	HI1337_LINK_FREQ_704MHZ_INDEX,
+};
+
+struct hi1337_reg_list {
+	u32 num_of_regs;
+	const struct hi1337_reg *regs;
+};
+
+struct hi1337_mode {
+	/* Frame width in pixels */
+	u32 width;
+
+	/* Frame height in pixels */
+	u32 height;
+
+	/* Horizontal timing size */
+	u32 llp;
+
+	/* Default vertical timing size */
+	u32 fll_def;
+
+	/* Link frequency needed for this resolution */
+	u32 link_freq_index;
+
+	/* Sensor register settings for this resolution */
+	const struct hi1337_reg_list reg_list;
+};
+
+static const s64 link_freq_menu_items[] = {
+	HI1337_LINK_FREQ_704MHZ,
+};
+
+static const struct hi1337_reg_list hi1337_init_reg_list = {
+	.num_of_regs = ARRAY_SIZE(hi1337_init_regs),
+	.regs = hi1337_init_regs,
+};
+
+static const struct hi1337_mode supported_modes[] = {
+	{
+		.width = 2032,
+		.height = 1524,
+		.fll_def = 3332,
+		.llp = 720,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(hi1337_mode_2032x1524_regs),
+			.regs = hi1337_mode_2032x1524_regs,
+		},
+		.link_freq_index = HI1337_LINK_FREQ_704MHZ_INDEX,
+	},
+	{
+		.width = 4000,
+		.height = 3000,
+		.fll_def = 3322,
+		.llp = 720,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(hi1337_mode_4000x3000_regs),
+			.regs = hi1337_mode_4000x3000_regs,
+		},
+		.link_freq_index = HI1337_LINK_FREQ_704MHZ_INDEX,
+	},
+	{
+		.width = 4128,
+		.height = 3096,
+		.fll_def = 3332,
+		.llp = 720,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(hi1337_mode_4128x3096_regs),
+			.regs = hi1337_mode_4128x3096_regs,
+		},
+		.link_freq_index = HI1337_LINK_FREQ_704MHZ_INDEX,
+	},
+};
+
+static const char * const hi1337_supply_names[] = {
+	"vddio", /* Digital I/O */
+	"vdda", /* Analog */
+	"vddd", /* Digital core */
+};
+
+#define HI1337_NUM_SUPPLIES ARRAY_SIZE(hi1337_supply_names)
+
+struct hi1337 {
+	struct device *dev;
+	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[HI1337_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+
+	/* V4L2 Controls */
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+
+	/* Current mode */
+	const struct hi1337_mode *cur_mode;
+
+	/* To serialize asynchronous callbacks */
+	struct mutex mutex;
+};
+
+#define to_hi1337(_sd) container_of(_sd, struct hi1337, sd)
+
+static u64 to_pixel_rate(u32 f_index)
+{
+	u64 pixel_rate = link_freq_menu_items[f_index] * 2 * HI1337_DATA_LANES;
+
+	do_div(pixel_rate, HI1337_RGB_DEPTH);
+
+	return pixel_rate;
+}
+
+/*
+ * The stock line length is shorter than the width for every mode. The pixel
+ * clock counts blanking in different units from the active pixels, so the
+ * value cannot express the horizontal blanking directly.
+ */
+static s64 to_hblank(const struct hi1337_mode *mode)
+{
+	if (mode->llp <= mode->width)
+		return 0;
+
+	return mode->llp - mode->width;
+}
+
+static int hi1337_read_reg(struct hi1337 *hi1337, u16 reg, u16 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&hi1337->sd);
+	struct i2c_msg msgs[2];
+	u8 addr_buf[2];
+	u8 data_buf[4] = {0};
+	int ret;
+
+	if (len > 4)
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = sizeof(addr_buf);
+	msgs[0].buf = addr_buf;
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+static int hi1337_write_reg(struct hi1337 *hi1337, u16 reg, u16 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&hi1337->sd);
+	u8 buf[6];
+
+	if (len > 4)
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << 8 * (4 - len), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+static int hi1337_write_reg_list(struct hi1337 *hi1337,
+				 const struct hi1337_reg_list *r_list)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < r_list->num_of_regs; i++) {
+		ret = hi1337_write_reg(hi1337, r_list->regs[i].address,
+				       HI1337_REG_VALUE_16BIT,
+				       r_list->regs[i].val);
+		if (ret) {
+			dev_err_ratelimited(hi1337->dev,
+					    "failed to write reg 0x%4.4x. error = %d",
+					    r_list->regs[i].address, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int hi1337_update_digital_gain(struct hi1337 *hi1337, u32 d_gain)
+{
+	int ret;
+
+	ret = hi1337_write_reg(hi1337, HI1337_REG_MWB_GR_GAIN,
+			       HI1337_REG_VALUE_16BIT, d_gain);
+	if (ret)
+		return ret;
+
+	ret = hi1337_write_reg(hi1337, HI1337_REG_MWB_GB_GAIN,
+			       HI1337_REG_VALUE_16BIT, d_gain);
+	if (ret)
+		return ret;
+
+	ret = hi1337_write_reg(hi1337, HI1337_REG_MWB_R_GAIN,
+			       HI1337_REG_VALUE_16BIT, d_gain);
+	if (ret)
+		return ret;
+
+	return hi1337_write_reg(hi1337, HI1337_REG_MWB_B_GAIN,
+				HI1337_REG_VALUE_16BIT, d_gain);
+}
+
+static int hi1337_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hi1337 *hi1337 = container_of(ctrl->handler,
+					     struct hi1337, ctrl_handler);
+	s64 exposure_max;
+	int ret = 0;
+
+	/* Propagate change of current control to all related controls */
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = hi1337->cur_mode->height + ctrl->val -
+			       HI1337_EXPOSURE_MAX_MARGIN;
+		__v4l2_ctrl_modify_range(hi1337->exposure,
+					 hi1337->exposure->minimum,
+					 exposure_max, hi1337->exposure->step,
+					 exposure_max);
+	}
+
+	/* V4L2 controls values will be applied only when power is already up */
+	if (!pm_runtime_get_if_in_use(hi1337->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = hi1337_write_reg(hi1337, HI1337_REG_ANALOG_GAIN,
+				       HI1337_REG_VALUE_08BIT, ctrl->val);
+		break;
+
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = hi1337_update_digital_gain(hi1337, ctrl->val);
+		break;
+
+	case V4L2_CID_EXPOSURE:
+		ret = hi1337_write_reg(hi1337, HI1337_REG_EXPOSURE,
+				       HI1337_REG_VALUE_16BIT, ctrl->val);
+		break;
+
+	case V4L2_CID_VBLANK:
+		/* Update FLL that meets expected vertical blanking */
+		ret = hi1337_write_reg(hi1337, HI1337_REG_FLL,
+				       HI1337_REG_VALUE_16BIT,
+				       hi1337->cur_mode->height + ctrl->val);
+		break;
+
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(hi1337->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops hi1337_ctrl_ops = {
+	.s_ctrl = hi1337_set_ctrl,
+};
+
+static int hi1337_init_controls(struct hi1337 *hi1337)
+{
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ctrl_hdlr = &hi1337->ctrl_handler;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	ctrl_hdlr->lock = &hi1337->mutex;
+	hi1337->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &hi1337_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(link_freq_menu_items) - 1,
+					0, link_freq_menu_items);
+	if (hi1337->link_freq)
+		hi1337->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hi1337->pixel_rate = v4l2_ctrl_new_std
+			    (ctrl_hdlr, &hi1337_ctrl_ops,
+			     V4L2_CID_PIXEL_RATE, 0,
+			     to_pixel_rate(HI1337_LINK_FREQ_704MHZ_INDEX),
+			     1,
+			     to_pixel_rate(HI1337_LINK_FREQ_704MHZ_INDEX));
+	hi1337->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &hi1337_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   HI1337_EXPOSURE_MAX_MARGIN,
+					   HI1337_FLL_MAX -
+					   hi1337->cur_mode->height, 1,
+					   hi1337->cur_mode->fll_def -
+					   hi1337->cur_mode->height);
+
+	h_blank = to_hblank(hi1337->cur_mode);
+
+	hi1337->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &hi1337_ctrl_ops,
+					   V4L2_CID_HBLANK, h_blank, h_blank, 1,
+					   h_blank);
+	if (hi1337->hblank)
+		hi1337->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &hi1337_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  HI1337_ANAL_GAIN_MIN, HI1337_ANAL_GAIN_MAX,
+			  HI1337_ANAL_GAIN_STEP, HI1337_ANAL_GAIN_MIN);
+	v4l2_ctrl_new_std(ctrl_hdlr, &hi1337_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  HI1337_DGTL_GAIN_MIN, HI1337_DGTL_GAIN_MAX,
+			  HI1337_DGTL_GAIN_STEP, HI1337_DGTL_GAIN_DEFAULT);
+	exposure_max = hi1337->cur_mode->fll_def - HI1337_EXPOSURE_MAX_MARGIN;
+	hi1337->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &hi1337_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     HI1337_EXPOSURE_MIN, exposure_max,
+					     HI1337_EXPOSURE_STEP,
+					     exposure_max);
+
+	ret = v4l2_fwnode_device_parse(hi1337->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &hi1337_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error;
+	}
+
+	hi1337->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static void hi1337_assign_pad_format(const struct hi1337_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+}
+
+static int hi1337_start_streaming(struct hi1337 *hi1337)
+{
+	int ret;
+
+	ret = hi1337_write_reg_list(hi1337, &hi1337_init_reg_list);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to write init table");
+		return ret;
+	}
+
+	ret = hi1337_write_reg_list(hi1337, &hi1337->cur_mode->reg_list);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to set mode");
+		return ret;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(hi1337->sd.ctrl_handler);
+	if (ret)
+		return ret;
+
+	ret = hi1337_write_reg(hi1337, HI1337_REG_MODE_SELECT,
+			       HI1337_REG_VALUE_16BIT, HI1337_MODE_STREAMING);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to set stream");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void hi1337_stop_streaming(struct hi1337 *hi1337)
+{
+	if (hi1337_write_reg(hi1337, HI1337_REG_MODE_SELECT,
+			     HI1337_REG_VALUE_16BIT, HI1337_MODE_STANDBY))
+		dev_err(hi1337->dev, "failed to set stream 0x%x",
+			HI1337_REG_MODE_SELECT);
+}
+
+static int hi1337_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	int ret = 0;
+
+	mutex_lock(&hi1337->mutex);
+	if (enable) {
+		ret = pm_runtime_resume_and_get(hi1337->dev);
+		if (ret) {
+			mutex_unlock(&hi1337->mutex);
+			return ret;
+		}
+
+		ret = hi1337_start_streaming(hi1337);
+		if (ret) {
+			hi1337_stop_streaming(hi1337);
+			pm_runtime_put(hi1337->dev);
+		}
+	} else {
+		hi1337_stop_streaming(hi1337);
+		pm_runtime_put(hi1337->dev);
+	}
+
+	mutex_unlock(&hi1337->mutex);
+
+	return ret;
+}
+
+static int hi1337_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	const struct hi1337_mode *mode;
+	s32 vblank_def;
+	s64 h_blank;
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes), width,
+				      height, fmt->format.width,
+				      fmt->format.height);
+
+	mutex_lock(&hi1337->mutex);
+	hi1337_assign_pad_format(mode, &fmt->format);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) =
+			fmt->format;
+	} else {
+		hi1337->cur_mode = mode;
+		__v4l2_ctrl_s_ctrl(hi1337->link_freq, mode->link_freq_index);
+		__v4l2_ctrl_s_ctrl_int64(hi1337->pixel_rate,
+					 to_pixel_rate(mode->link_freq_index));
+
+		/* Update limits and set FPS to default */
+		vblank_def = mode->fll_def - mode->height;
+		__v4l2_ctrl_modify_range(hi1337->vblank,
+					 HI1337_EXPOSURE_MAX_MARGIN,
+					 HI1337_FLL_MAX - mode->height, 1,
+					 vblank_def);
+		__v4l2_ctrl_s_ctrl(hi1337->vblank, vblank_def);
+
+		h_blank = to_hblank(mode);
+		__v4l2_ctrl_modify_range(hi1337->hblank, h_blank, h_blank, 1,
+					 h_blank);
+	}
+
+	mutex_unlock(&hi1337->mutex);
+
+	return 0;
+}
+
+static int hi1337_get_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	mutex_lock(&hi1337->mutex);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state,
+							    fmt->pad);
+	else
+		hi1337_assign_pad_format(hi1337->cur_mode, &fmt->format);
+
+	mutex_unlock(&hi1337->mutex);
+
+	return 0;
+}
+
+static int hi1337_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	return 0;
+}
+
+static int hi1337_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+
+	fse->min_width = supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int hi1337_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	mutex_lock(&hi1337->mutex);
+	hi1337_assign_pad_format(&supported_modes[0],
+				 v4l2_subdev_state_get_format(fh->state, 0));
+	mutex_unlock(&hi1337->mutex);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops hi1337_video_ops = {
+	.s_stream = hi1337_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops hi1337_pad_ops = {
+	.set_fmt = hi1337_set_format,
+	.get_fmt = hi1337_get_format,
+	.enum_mbus_code = hi1337_enum_mbus_code,
+	.enum_frame_size = hi1337_enum_frame_size,
+};
+
+static const struct v4l2_subdev_ops hi1337_subdev_ops = {
+	.video = &hi1337_video_ops,
+	.pad = &hi1337_pad_ops,
+};
+
+static const struct media_entity_operations hi1337_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops hi1337_internal_ops = {
+	.open = hi1337_open,
+};
+
+/*
+ * Power-up order and delays follow the stock SM-X800 sequence: supplies,
+ * MCLK, 10 ms, reset release, 12 ms. Per-rail settling time belongs to the
+ * regulators' startup-delay-us in the device tree.
+ */
+static int hi1337_power_on(struct hi1337 *hi1337)
+{
+	int ret;
+
+	ret = regulator_bulk_enable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(hi1337->clk);
+	if (ret < 0)
+		goto err_reg;
+
+	usleep_range(10000, 11000);
+
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 0);
+	usleep_range(12000, 13000);
+
+	return 0;
+
+err_reg:
+	regulator_bulk_disable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+
+	return ret;
+}
+
+static int hi1337_power_off(struct hi1337 *hi1337)
+{
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 1);
+	usleep_range(1000, 2000);
+
+	clk_disable_unprepare(hi1337->clk);
+	usleep_range(1000, 2000);
+
+	return regulator_bulk_disable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+}
+
+static int hi1337_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	return hi1337_power_off(hi1337);
+}
+
+static int hi1337_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	return hi1337_power_on(hi1337);
+}
+
+static int hi1337_get_power_resources(struct hi1337 *hi1337)
+{
+	struct device *dev = hi1337->dev;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < HI1337_NUM_SUPPLIES; i++)
+		hi1337->supplies[i].supply = hi1337_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, HI1337_NUM_SUPPLIES,
+				      hi1337->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* The pin is active-low; logical 1 holds the sensor in reset. */
+	hi1337->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(hi1337->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(hi1337->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	return 0;
+}
+
+static int hi1337_identify_module(struct hi1337 *hi1337)
+{
+	u32 vendor, model;
+	int ret;
+
+	ret = hi1337_read_reg(hi1337, HI1337_REG_VENDOR_ID,
+			      HI1337_REG_VALUE_16BIT, &vendor);
+	if (ret)
+		return ret;
+
+	ret = hi1337_read_reg(hi1337, HI1337_REG_MODEL_ID,
+			      HI1337_REG_VALUE_16BIT, &model);
+	if (ret)
+		return ret;
+
+	dev_info(hi1337->dev, "vendor id 0x%4.4x, model id 0x%4.4x\n",
+		 vendor, model);
+
+	if (vendor != HI1337_VENDOR_ID) {
+		dev_err(hi1337->dev, "vendor id mismatch: %x!=%x",
+			HI1337_VENDOR_ID, vendor);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+static int hi1337_check_hwcfg(struct device *dev)
+{
+	struct fwnode_handle *ep;
+	struct fwnode_handle *fwnode = dev_fwnode(dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	int ret;
+	unsigned int i, j;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != HI1337_DATA_LANES) {
+		dev_err(dev, "number of CSI2 data lanes %d is not supported",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto check_hwcfg_error;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(dev, "no link frequencies defined");
+		ret = -EINVAL;
+		goto check_hwcfg_error;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(link_freq_menu_items); i++) {
+		for (j = 0; j < bus_cfg.nr_of_link_frequencies; j++) {
+			if (link_freq_menu_items[i] ==
+				bus_cfg.link_frequencies[j])
+				break;
+		}
+
+		if (j == bus_cfg.nr_of_link_frequencies) {
+			dev_err(dev, "no link frequency %lld supported",
+				link_freq_menu_items[i]);
+			ret = -EINVAL;
+			goto check_hwcfg_error;
+		}
+	}
+
+check_hwcfg_error:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static void hi1337_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(hi1337->dev);
+	if (!pm_runtime_status_suspended(hi1337->dev))
+		hi1337_power_off(hi1337);
+	pm_runtime_set_suspended(hi1337->dev);
+
+	mutex_destroy(&hi1337->mutex);
+}
+
+static int hi1337_probe(struct i2c_client *client)
+{
+	struct hi1337 *hi1337;
+	unsigned long freq;
+	int ret;
+
+	hi1337 = devm_kzalloc(&client->dev, sizeof(*hi1337), GFP_KERNEL);
+	if (!hi1337)
+		return -ENOMEM;
+
+	hi1337->dev = &client->dev;
+
+	hi1337->clk = devm_v4l2_sensor_clk_get(hi1337->dev, NULL);
+	if (IS_ERR(hi1337->clk))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->clk),
+				     "failed to get clock\n");
+
+	freq = clk_get_rate(hi1337->clk);
+	if (freq != HI1337_MCLK) {
+		ret = clk_set_rate(hi1337->clk, HI1337_MCLK);
+		if (ret)
+			return dev_err_probe(hi1337->dev, ret,
+					     "failed to set clock rate\n");
+		freq = clk_get_rate(hi1337->clk);
+	}
+	if (freq != HI1337_MCLK)
+		return dev_err_probe(hi1337->dev, -EINVAL,
+				     "external clock %lu is not supported\n",
+				     freq);
+
+	ret = hi1337_check_hwcfg(hi1337->dev);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "failed to get HW configuration\n");
+
+	ret = hi1337_get_power_resources(hi1337);
+	if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&hi1337->sd, client, &hi1337_subdev_ops);
+	mutex_init(&hi1337->mutex);
+
+	ret = hi1337_power_on(hi1337);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to power on: %d", ret);
+		goto probe_error_mutex_destroy;
+	}
+
+	ret = hi1337_identify_module(hi1337);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to find sensor: %d", ret);
+		goto probe_error_power_off;
+	}
+
+	hi1337->cur_mode = &supported_modes[0];
+	ret = hi1337_init_controls(hi1337);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to init controls: %d", ret);
+		goto probe_error_power_off;
+	}
+
+	hi1337->sd.internal_ops = &hi1337_internal_ops;
+	hi1337->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	hi1337->sd.entity.ops = &hi1337_subdev_entity_ops;
+	hi1337->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	hi1337->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&hi1337->sd.entity, 1, &hi1337->pad);
+	if (ret) {
+		dev_err(hi1337->dev, "failed to init entity pads: %d", ret);
+		goto probe_error_v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&hi1337->sd);
+	if (ret < 0) {
+		dev_err(hi1337->dev, "failed to register V4L2 subdev: %d",
+			ret);
+		goto probe_error_media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(hi1337->dev);
+	pm_runtime_enable(hi1337->dev);
+	pm_runtime_idle(hi1337->dev);
+
+	return 0;
+
+probe_error_media_entity_cleanup:
+	media_entity_cleanup(&hi1337->sd.entity);
+
+probe_error_v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(hi1337->sd.ctrl_handler);
+
+probe_error_power_off:
+	hi1337_power_off(hi1337);
+
+probe_error_mutex_destroy:
+	mutex_destroy(&hi1337->mutex);
+
+	return ret;
+}
+
+static const struct dev_pm_ops hi1337_pm_ops = {
+	RUNTIME_PM_OPS(hi1337_runtime_suspend, hi1337_runtime_resume, NULL)
+};
+
+static const struct of_device_id hi1337_of_match[] = {
+	{ .compatible = "hynix,hi1337" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, hi1337_of_match);
+
+static struct i2c_driver hi1337_i2c_driver = {
+	.driver = {
+		.name = "hi1337",
+		.pm = pm_ptr(&hi1337_pm_ops),
+		.of_match_table = hi1337_of_match,
+	},
+	.probe = hi1337_probe,
+	.remove = hi1337_remove,
+};
+
+module_i2c_driver(hi1337_i2c_driver);
+
+MODULE_AUTHOR("Aaron Bockelie <aaronsb@gmail.com>");
+MODULE_DESCRIPTION("Hynix HI1337 sensor driver");
+MODULE_LICENSE("GPL");
