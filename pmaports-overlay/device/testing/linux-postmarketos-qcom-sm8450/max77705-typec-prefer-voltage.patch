usb: typec: max77705: prefer the higher voltage at equal power

With the 15 W cap, a 5 V 3 A PDO and a 9 V 3 A PDO both give 15 W, but
the 9 V one computes as 9 V x 1666 mA = 14994 mW and lost to 5 V on
rounding: on a 5 V / 9 V charger the sink stayed at 5 V and never
requested 9 V. Treat PDOs within 100 mW as equal and prefer the higher
voltage, as stock does; the input current and the heat in the cable
drop.

diff --git a/drivers/usb/typec/max77705.c b/drivers/usb/typec/max77705.c
index c185f4bad..8937fd3c3 100644
--- a/drivers/usb/typec/max77705.c
+++ b/drivers/usb/typec/max77705.c
@@ -161,6 +161,8 @@ enum max77705_ccistat {
 #define MAX77705_PD_MAX_MV		9000
 #define MAX77705_PD_MAX_MA		3000
 #define MAX77705_PD_MAX_MW		15000
+/* power difference below which PDOs count as equal */
+#define MAX77705_PD_MW_SLACK		100
 
 #define MAX77705_ILIM_SAFE_UA		500000
 #define MAX77705_PD_MAX_REQUESTS	3
@@ -710,18 +712,26 @@ static int max77705_usbc_read_srccaps(struct max77705_usbc *u)
 /* The fixed PDO giving the most power under the policy; ties go higher. */
 static unsigned int max77705_usbc_best_pos(struct max77705_usbc *u)
 {
-	unsigned int i, best = 0, best_mw = 0;
+	unsigned int i, best = 0, best_mw = 0, best_mv = 0;
 
 	for (i = 0; i < u->nr_src_pdos; i++) {
 		u32 pdo = u->src_pdos[i];
-		unsigned int mw;
+		unsigned int mw, mv;
 
 		if (!max77705_pdo_acceptable(pdo))
 			continue;
 
-		mw = pdo_fixed_voltage(pdo) * (max77705_pdo_ilim_ua(pdo) / 1000) / 1000;
-		if (mw >= best_mw) {
-			best_mw = mw;
+		mv = pdo_fixed_voltage(pdo);
+		mw = mv * (max77705_pdo_ilim_ua(pdo) / 1000) / 1000;
+		/*
+		 * Under the power cap 5 V 3 A and 9 V 1.66 A are the same
+		 * 15 W; prefer the higher voltage (less current in the cable),
+		 * as stock does, instead of losing it to rounding.
+		 */
+		if (mw > best_mw + MAX77705_PD_MW_SLACK ||
+		    (mw + MAX77705_PD_MW_SLACK >= best_mw && mv > best_mv)) {
+			best_mw = max(mw, best_mw);
+			best_mv = mv;
 			best = i + 1;
 		}
 	}
