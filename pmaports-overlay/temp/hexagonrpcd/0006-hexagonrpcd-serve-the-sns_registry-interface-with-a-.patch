+/*
+ * Reverse engineered from the stock libsns_registry_skel.so (SM8450):
+ *
+ *	interface sns_registry {
+ *		long get_property(in sequence<char> prop_name,
+ *				  rout sequence<char> prop_value);
+ *	}
+ *
+ * The primitive input buffer carries the two sequence lengths, the second
+ * input buffer the NUL-terminated property name, and the only output buffer
+ * receives the NUL-terminated value.
+ */
+static struct hrpc_arg_def_interp4 sns_registry_get_property_args[] = {
+	{ HRPC_ARG_BLOB_SEQ, sizeof(char) },
+	{ HRPC_ARG_OUT_BLOB_SEQ, sizeof(char) },
+};
+
+const struct hrpc_method_def_interp4 sns_registry_get_property_def = {
+	.msg_id = 0,
+	.n_args = HRPC_ARRAY_SIZE(sns_registry_get_property_args),
+	.args = sns_registry_get_property_args,
+	.n_inner_types = 0,
+	.inner_types = NULL,
+};
