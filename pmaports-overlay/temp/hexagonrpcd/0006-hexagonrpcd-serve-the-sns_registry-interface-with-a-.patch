diff --git a/hexagonrpcd/sns_registry.c b/hexagonrpcd/sns_registry.c
new file mode 100644
index 0000000..21c21da
--- /dev/null
+++ b/hexagonrpcd/sns_registry.c
@@ -0,0 +1,137 @@
+/*
+ * Sensor registry property interface
+ *
+ * Copyright (C) 2026 HexagonRPC Contributors
+ *
+ * This file is part of HexagonRPC.
+ *
+ * HexagonRPC is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include <libhexagonrpc/error.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "interface/sns_registry.h"
+#include "iobuffer.h"
+#include "listener.h"
+#include "sns_registry.h"
+
+/*
+ * The Snapdragon Sensor Core opens this interface at boot and asks for
+ * Android system properties. On Android the skeleton answers from
+ * property_get(); here the answers come from a fixed table. Unknown names
+ * get an empty string, which is what property_get() returns for an unset
+ * property.
+ */
+struct sns_registry_property {
+	const char *name;
+	const char *value;
+};
+
+static const struct sns_registry_property sns_registry_properties[] = {
+	{ "ro.revision", "4" },
+	{ "ro.boot.hardware", "qcom" },
+	{ "ro.hardware", "qcom" },
+	{ "ro.product.model", "SM-X800" },
+	{ "ro.product.device", "gts8pwifi" },
+};
+
+static const char *sns_registry_lookup(const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < HRPC_ARRAY_SIZE(sns_registry_properties); i++) {
+		if (!strcmp(sns_registry_properties[i].name, name))
+			return sns_registry_properties[i].value;
+	}
+
+	return NULL;
+}
+
+static uint32_t sns_registry_get_property(void *data,
+					  const struct fastrpc_io_buffer *inbufs,
+					  struct fastrpc_io_buffer *outbufs)
+{
+	const char *name = inbufs[1].p;
+	const char *value;
+	size_t len;
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("sns_registry_get_property: inbufs[0].s=%zu inbufs[1].s=%zu outbufs[0].s=%zu\n",
+	       inbufs[0].s, inbufs[1].s, outbufs[0].s);
+#endif
+
+	if (inbufs[1].s == 0 || name[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (outbufs[0].s == 0)
+		return AEE_EBADPARM;
+
+	memset(outbufs[0].p, 0, outbufs[0].s);
+
+	value = sns_registry_lookup(name);
+	if (value == NULL) {
+		fprintf(stderr, "sns_registry: unknown property %s, answering empty\n",
+			name);
+		return 0;
+	}
+
+	len = strlen(value);
+	if (len + 1 > outbufs[0].s) {
+		fprintf(stderr, "sns_registry: value of %s does not fit in %zu bytes\n",
+			name, outbufs[0].s);
+		return AEE_EBADPARM;
+	}
+
+	memcpy(outbufs[0].p, value, len + 1);
+
+	printf("sns_registry_get_property(%s) -> %s\n", name, value);
+
+	return 0;
+}
+
+struct fastrpc_interface *fastrpc_sns_registry_init(void)
+{
+	struct fastrpc_interface *iface;
+
+	iface = malloc(sizeof(struct fastrpc_interface));
+	if (iface == NULL)
+		return NULL;
+
+	memcpy(iface, &sns_registry_interface, sizeof(struct fastrpc_interface));
+	iface->data = NULL;
+
+	return iface;
+}
+
+void fastrpc_sns_registry_deinit(struct fastrpc_interface *iface)
+{
+	free(iface);
+}
+
+static const struct fastrpc_function_impl sns_registry_procs[] = {
+	{
+		.def = &sns_registry_get_property_def,
+		.impl = sns_registry_get_property,
+	},
+};
+
+const struct fastrpc_interface sns_registry_interface = {
+	.name = "sns_registry",
+	.n_procs = 1,
+	.procs = sns_registry_procs,
+};
