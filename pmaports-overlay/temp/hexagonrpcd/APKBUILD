# Forked from Alpine (community/hexagonrpcd 0.4.0-r3) as a git snapshot of
# upstream main plus seven patches. The Snapdragon Sensor Core on the
# SM8450 rewrites its registry during initialisation; 0.4.0 serves the
# registry read-only and lacks the sns_registry local interface, so the
# sensor core fails at boot. The patches are queued for upstream
# (https://github.com/linux-msm/hexagonrpc/issues/19); this package goes
# away when a release carries them. Same pkgname and a higher version, so
# apk prefers it over Alpine's build.
#
# Extras over Alpine's aport: sscregistrygen (upstream tools/, needs json-c)
# is installed so gts8pwifi-fw-extract can pre-populate the registry.
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=hexagonrpcd
pkgver=0.5.0_git20260824
pkgrel=0
_commit=598b591ae9da6a6cfe2ca5ea78998019ca6395ea
pkgdesc="Qualcomm HexagonFS daemon (git snapshot with sensor registry write support)"
url="https://github.com/linux-msm/hexagonrpc"
# s390x: fails on 1 test. Hexagonrpcd is specific to Qualcomm ARM SoCs, so let's ignore it for now.
arch="all !s390x"
license="GPL-3.0-or-later"
makedepends="json-c-dev linux-headers meson"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd $pkgname-udev"

source="$pkgname-$_commit.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/$_commit.tar.gz
	10-fastrpc.rules
	$pkgname-adsp-rootpd.initd
	$pkgname-adsp-sensorspd.initd
	$pkgname-sdsp.initd
	0001-hexagonfs-add-create-write-truncate-unlink-and-renam.patch
	0002-apps_std-serve-fopen-fwrite-fsync-fremove-ftrunc-and.patch
	0003-listener-answer-unsupported-requests-and-fetch-input.patch
	0004-rpcd_builder-map-the-registry-s-parent-directory-whe.patch
	0005-hexagonrpcd-fix-descriptor-lifetimes-and-the-write-p.patch
	0006-hexagonrpcd-serve-the-sns_registry-interface-with-a-.patch
	0007-hexagonrpcd-line-buffer-stdout.patch
	"
builddir="$srcdir/hexagonrpc-$_commit"

build() {
	# hexagonrpcd_verbose prints every remote method call; off for the
	# package, as upstream's default.
	abuild-meson \
		-Db_lto=true \
		-Dhexagonrpcd_verbose=false \
		. output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# Upstream builds sscregistrygen when json-c is present and does not
	# install it. It turns the vendor sensor configs into registry files.
	install -Dm755 output/tools/sscregistrygen "$pkgdir"/usr/bin/sscregistrygen

	# Allow access for FastRPC node for FastRPC user/group
	install -Dm644 "$srcdir"/10-fastrpc.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	install -Dm755 "$srcdir"/$pkgname-adsp-rootpd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-rootpd
	install -Dm755 "$srcdir"/$pkgname-adsp-sensorspd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-sensorspd
	install -Dm755 "$srcdir"/$pkgname-sdsp.initd "$pkgdir"/etc/init.d/$pkgname-sdsp
}

