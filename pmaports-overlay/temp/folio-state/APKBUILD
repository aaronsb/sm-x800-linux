# Folio, lid and pen state daemon for the Galaxy Tab S8+ (samsung-gts8pwifi).
# Fuses the pogo keyboard device, the two hall switches and a magnetometer
# sample through libssc into SW_LID and SW_PEN_INSERTED on a uinput device
# named "folio-state". The device package depends on it; console-blank reads
# the virtual device for the display policy. ADR-002 in the port's repo.
#
# The classifier (folio_state.c) is plain C and check() runs its host test.
maintainer="Aaron <aaronsb@gmail.com>"
pkgname=folio-state
pkgver=0.1
pkgrel=0
pkgdesc="Folio, lid and pen state daemon for the Galaxy Tab S8+ (virtual SW_LID device)"
url="https://github.com/aaronsb/sm-x800-linux"
arch="aarch64"
license="MIT"
makedepends="glib-dev libssc-dev libqmi-dev libevdev-dev pkgconf"
subpackages="$pkgname-systemd"
source="
	folio_state.h
	folio_state.c
	foliod.c
	test_folio_state.c
	Makefile
	folio-state.service
	folio-state.conf
	80-folio-state.preset
	"
builddir="$srcdir"

build() {
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 "$srcdir"/folio-state.conf \
		"$pkgdir"/etc/conf.d/folio-state
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/folio-state.service \
		"$subpkgdir"/usr/lib/systemd/system/folio-state.service
	install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -sf ../folio-state.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/folio-state.service
	# vendor wants symlinks read "disabled" from is-enabled without a preset
	install -Dm644 "$srcdir"/80-folio-state.preset \
		"$subpkgdir"/usr/lib/systemd/system-preset/80-folio-state.preset
}

